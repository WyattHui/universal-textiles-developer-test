{
    "name": "ut-developer-test",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "npm run development",
        "development": "mix",
        "watch": "mix watch",
        "watch-poll": "mix watch -- --watch-options-poll=1000",
        "hot": "mix watch --hot",
        "prod": "npm run production",
        "production": "mix --production",
        "docker-login-aws": "aws ecr get-login-password --region eu-west-2 | docker login --username AWS --password-stdin 267585271655.dkr.ecr.eu-west-2.amazonaws.com",
        "build": "docker build -t ut-developer-test .",
        "tag": "docker tag ut-developer-test:latest 267585271655.dkr.ecr.eu-west-2.amazonaws.com/ut-developer-test:latest",
        "push": "docker push 267585271655.dkr.ecr.eu-west-2.amazonaws.com/ut-developer-test:latest",
        "aws-ecs-update-service": "aws ecs update-service --cluster arn:aws:ecs:eu-west-2:267585271655:cluster/ut-developer-test-cluster --service arn:aws:ecs:eu-west-2:267585271655:service/ut-developer-test-cluster/ut-developer-test-service --force-new-deployment --region eu-west-2"
    },
    "devDependencies": {
        "axios": "^0.21",
        "bootstrap": "^4.0.0",
        "eslint": "^7.22.0",
        "jquery": "^3.2",
        "laravel-mix": "^6.0.6",
        "lodash": "^4.17.19",
        "popper.js": "^1.16.1",
        "postcss": "^8.1.14",
        "resolve-url-loader": "^2.3.1",
        "sass": "^1.20.1",
        "sass-loader": "^8.0.0",
        "vue": "^2.5.17",
        "vue-loader": "^15.9.5",
        "vue-router": "^3.5.1",
        "vue-template-compiler": "^2.6.10",
        "webpack-cli": "^4.5.0"
    }
}
